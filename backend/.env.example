APP_NAME=Dynamic Form Builder API
APP_VERSION=1.0.0
DEBUG=True

DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/dynamic_form_builder_db

JWT_SECRET_KEY=YOUR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10